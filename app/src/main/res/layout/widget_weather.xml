<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout. Only the subset of views and attributes RemoteViews
     supports is used here: no ConstraintLayout, no custom views, no data binding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- place + refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="@string/app_name" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- icon + temperature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:text="--°" />

        <TextView
            android:id="@+id/widget_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#B8FFFFFF"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_cond"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:text="" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:text="" />

</LinearLayout>
