<?xml version="1.0" encoding="utf-8"?>
<!-- The app's day gradient, so the widget reads as part of the same product
     sitting on the user's wallpaper. The night variant is applied at runtime by
     swapping to widget_background_night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="290"
        android:startColor="#17457F"
        android:endColor="#3D87C7" />
</shape>
