    <string name="about_credits">Tak og licenser</string>
    <string name="about_credits_data">Vejrdata og stedsøgning kommer fra Open-Meteo.com og bruges på deres gratis vilkår for ikke-kommerciel brug.</string>
    <string name="about_credits_license">Weather er fri software, udgivet under Apache License 2.0.</string>
