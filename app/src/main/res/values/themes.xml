<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws its own gradient background edge to edge, so the platform
         theme only needs to stay out of the way until Compose takes over. -->
    <style name="Theme.Weather" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
